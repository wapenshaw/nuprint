// nuprint.app: a Worker that serves only static files (no Worker code, so every
// request is a free static-asset request). `npm run build` writes ./dist first.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nuprint-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "nuprint.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
